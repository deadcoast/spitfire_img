<UserControl
    x:Class="ImageViewer.App.Views.BottomInfoBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="16,8" Style="{StaticResource ChromePanelBorderStyle}">
        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FilenameText" Foreground="{ThemeResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PositionText" Grid.Column="1" Foreground="{ThemeResource SecondaryTextBrush}" />
            <TextBlock x:Name="DimensionsText" Grid.Column="2" Foreground="{ThemeResource SecondaryTextBrush}" />
            <TextBlock x:Name="FolderText" Grid.Column="3" Foreground="{ThemeResource MutedTextBrush}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</UserControl>
