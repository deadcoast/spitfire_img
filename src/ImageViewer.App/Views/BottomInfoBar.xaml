<UserControl
    x:Class="ImageViewer.App.Views.BottomInfoBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="InfoBarSurface" AutomationProperties.Name="Image status"
            Padding="{StaticResource ViewerBottomInfoBarPadding}" Style="{StaticResource ViewerChromeInfoBarBorderStyle}">
        <Grid ColumnSpacing="{StaticResource ViewerSpace16}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FilenameText" Style="{StaticResource ViewerTextMetadataValueStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PositionText" Grid.Column="1" Style="{StaticResource ViewerTextMetadataValueStyle}" />
            <TextBlock x:Name="DimensionsText" Grid.Column="2" Style="{StaticResource ViewerTextMetadataValueStyle}" />
            <TextBlock x:Name="ZoomText" Grid.Column="3" MinWidth="{StaticResource ViewerZoomStatusMinWidth}" Style="{StaticResource ViewerTextMetadataValueStyle}" />
            <TextBlock x:Name="ModeText" Grid.Column="4" Style="{StaticResource ViewerTextMetadataValueStyle}" />
            <TextBlock x:Name="FolderText" Grid.Column="5" MaxWidth="180" Style="{StaticResource ViewerTextCaptionStyle}" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</UserControl>
