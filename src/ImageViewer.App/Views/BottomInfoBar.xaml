<UserControl
    x:Class="ImageViewer.App.Views.BottomInfoBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="16,8" Background="#AA202020" CornerRadius="8">
        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FilenameText" Foreground="White" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PositionText" Grid.Column="1" Foreground="#DDFFFFFF" />
            <TextBlock x:Name="DimensionsText" Grid.Column="2" Foreground="#DDFFFFFF" />
            <TextBlock x:Name="FolderText" Grid.Column="3" Foreground="#AAFFFFFF" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</UserControl>
