<UserControl
    x:Class="ImageViewer.App.Views.GridLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Grid layout surface"
    IsTabStop="True">
    <Grid
        x:Name="LayoutRoot"
        Background="{ThemeResource ViewerCanvasBackgroundBrush}"
        Opacity="{StaticResource ViewerHiddenOpacity}"
        Visibility="Collapsed">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="GridLayoutTransform" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Canvas x:Name="ImageHost" Grid.Row="1" Margin="{StaticResource ViewerGridCanvasMargin}" />
        <Border
            x:Name="GridModeHud"
            Margin="{StaticResource ViewerGridHeaderMargin}"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource ViewerGridHudBorderStyle}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource ViewerSpace16}">
                <Grid ColumnSpacing="{StaticResource ViewerInfoBarColumnSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="Grid"
                        Style="{StaticResource ViewerTextCommandHeaderStyle}" />
                    <TextBlock
                        x:Name="GridDensityText"
                        Grid.Column="1"
                        Style="{StaticResource ViewerTextNumericStyle}" />
                </Grid>
                <TextBlock
                    x:Name="GridPageText"
                    Style="{StaticResource ViewerTextStatusStyle}" />
                <TextBlock
                    x:Name="GridStatusText"
                    Visibility="Collapsed"
                    Style="{StaticResource ViewerTextStatusStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
