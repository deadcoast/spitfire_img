<UserControl
    x:Class="ImageViewer.App.Views.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Opacity="{StaticResource ViewerHiddenOpacity}"
    TabFocusNavigation="Cycle"
    Visibility="Collapsed">
    <Grid
        x:Name="PaletteRoot"
        Background="{ThemeResource ViewerTransparentBrush}"
        PointerPressed="OnPaletteRootPointerPressed">
        <Border
            x:Name="PalettePanel"
            Width="{StaticResource ViewerCommandPaletteWidth}"
            MaxHeight="{StaticResource ViewerOverlayMaxHeight}"
            Padding="{StaticResource ViewerOverlayContentPadding}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="{StaticResource ViewerCommandPaletteMargin}"
            AutomationProperties.Name="Command palette"
            Style="{StaticResource ViewerCommandPalettePanelBorderStyle}">
            <Border.RenderTransform>
                <CompositeTransform x:Name="PalettePanelTransform" />
            </Border.RenderTransform>
            <StackPanel Spacing="{StaticResource ViewerPanelContentSpacing}">
                <Grid
                    x:Name="PaletteHeader"
                    Padding="{StaticResource ViewerCommandPanelHeaderPadding}"
                    ColumnSpacing="{StaticResource ViewerCommandPaletteHeaderSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="PaletteTitle"
                        Style="{StaticResource ViewerTextCommandPaletteTitleStyle}"
                        Text="Command palette" />
                    <TextBlock
                        x:Name="ResultSummaryText"
                        Grid.Column="1"
                        Style="{StaticResource ViewerTextStatusStyle}"
                        Text="Ready" />
                </Grid>
                <TextBox
                    x:Name="SearchInput"
                    AutomationProperties.Name="Search commands"
                    KeyDown="OnPaletteKeyDown"
                    PlaceholderText="Type a command..."
                    TextChanged="OnSearchTextChanged" />
                <ListView
                    x:Name="CommandList"
                    IsItemClickEnabled="True"
                    ItemContainerStyle="{StaticResource ViewerCommandPaletteListViewItemStyle}"
                    ItemClick="OnCommandClicked"
                    KeyDown="OnPaletteKeyDown"
                    MaxHeight="{StaticResource ViewerOverlayResultsMaxHeight}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border
                                    x:Name="CommandHeaderSurface"
                                    DataContextChanged="OnCommandHeaderDataContextChanged"
                                    Loaded="OnCommandHeaderLoaded"
                                    Padding="{StaticResource ViewerCommandHeaderPadding}"
                                    Style="{StaticResource ViewerCommandHeaderBorderStyle}"
                                    Tag="{Binding}"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        Style="{StaticResource ViewerTextCommandHeaderStyle}"
                                        Text="{Binding HeaderText}" />
                                </Border>
                                <Border
                                    x:Name="CommandRowSurface"
                                    DataContextChanged="OnCommandRowDataContextChanged"
                                    Loaded="OnCommandRowLoaded"
                                    Padding="{StaticResource ViewerCommandShortcutPadding}"
                                    Style="{StaticResource ViewerCommandRowBorderStyle}"
                                    Tag="{Binding}"
                                    Visibility="Collapsed">
                                    <Grid ColumnSpacing="{StaticResource ViewerCommandRowColumnSpacing}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="{StaticResource ViewerCommandRowContentSpacing}">
                                            <TextBlock
                                                x:Name="CommandTitleText"
                                                DataContextChanged="OnCommandTitleDataContextChanged"
                                                Loaded="OnCommandTitleLoaded"
                                                Style="{StaticResource ViewerTextCommandTitleStyle}"
                                                Tag="{Binding Match}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                x:Name="CommandDescriptionText"
                                                Style="{StaticResource ViewerTextCommandDescriptionStyle}"
                                                Text="{Binding Match.Description}" />
                                            <TextBlock
                                                x:Name="CommandCategoryText"
                                                Style="{StaticResource ViewerTextCaptionStyle}"
                                                Text="{Binding Match.Category}" />
                                        </StackPanel>
                                        <Border
                                            x:Name="CommandShortcutPill"
                                            Grid.Column="1"
                                            MinWidth="{StaticResource ViewerCommandShortcutMinWidth}"
                                            Padding="{StaticResource ViewerCommandShortcutPillPadding}"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource ViewerCommandShortcutPillBorderStyle}">
                                            <TextBlock
                                                x:Name="CommandShortcutText"
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource ViewerTextCommandShortcutStyle}"
                                                Text="{Binding Match.KeyboardShortcut}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border
                    x:Name="NoMatchesPanel"
                    Padding="{StaticResource ViewerCommandEmptyStatePadding}"
                    Style="{StaticResource ViewerCommandRowBorderStyle}"
                    Visibility="Collapsed">
                    <StackPanel Spacing="{StaticResource ViewerCommandRowContentSpacing}">
                        <TextBlock
                            x:Name="NoMatchesTitle"
                            Style="{StaticResource ViewerTextCommandTitleStyle}"
                            Text="No matching commands" />
                        <TextBlock
                            x:Name="NoMatchesBody"
                            Style="{StaticResource ViewerTextCommandDescriptionStyle}"
                            Text="Try a command name, category, or shortcut." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
