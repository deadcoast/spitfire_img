<UserControl
    x:Class="ImageViewer.App.Views.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Opacity="0"
    Visibility="Collapsed">
    <Grid
        x:Name="OverlayRoot"
        Background="#66000000"
        Tapped="OnOverlayTapped">
        <Border
            Width="620"
            MaxHeight="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="24,64,24,0"
            Padding="14"
            Style="{StaticResource ChromePanelBorderStyle}"
            Tapped="OnPanelTapped">
            <StackPanel Spacing="10">
                <TextBox
                    x:Name="CommandInput"
                    PlaceholderText="Search commands..."
                    TextChanged="OnCommandInputTextChanged"
                    KeyDown="OnCommandInputKeyDown" />
                <TextBlock
                    x:Name="EmptyStateText"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    Text="No matching commands found"
                    Visibility="Collapsed" />
                <ListView
                    x:Name="CommandList"
                    MaxHeight="420"
                    IsItemClickEnabled="True"
                    ItemClick="OnCommandClicked"
                    SelectionMode="Single" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
