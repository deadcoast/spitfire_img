<UserControl
    x:Class="ImageViewer.App.Views.FadingChrome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ImageViewer.App.Views">
    <Grid
        x:Name="ChromeRoot"
        AutomationProperties.Name="Application chrome"
        IsHitTestVisible="True">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ChromeActivityStates">
                <VisualState x:Name="Active">
                    <VisualState.Setters>
                        <Setter Target="TopChromeSurface.Opacity" Value="{StaticResource ViewerChromeActiveOpacity}" />
                        <Setter Target="InfoBar.Opacity" Value="{StaticResource ViewerChromeActiveOpacity}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Idle">
                    <VisualState.Setters>
                        <Setter Target="TopChromeSurface.Opacity" Value="{StaticResource ViewerChromeIdleOpacity}" />
                        <Setter Target="InfoBar.Opacity" Value="{StaticResource ViewerChromeIdleOpacity}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border
            x:Name="TopChromeSurface"
            VerticalAlignment="Top"
            Margin="{StaticResource ViewerChromeOuterMargin}"
            Padding="{StaticResource ViewerMenuBarPadding}"
            Style="{StaticResource ViewerChromeShellBorderStyle}">
            <Grid
                x:Name="TopChromeContent"
                ColumnSpacing="{StaticResource ViewerChromeShellColumnSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <MenuBar>
                    <MenuBarItem x:Name="FileMenu" Title="File">
                        <MenuFlyoutItem Text="Open File" Click="OnOpenFileClicked" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Exit" Click="OnExitClicked" />
                    </MenuBarItem>
                    <MenuBarItem Title="View">
                        <MenuFlyoutItem Text="Zoom In" Click="OnZoomInClicked" />
                        <MenuFlyoutItem Text="Zoom Out" Click="OnZoomOutClicked" />
                        <MenuFlyoutItem Text="Actual Size" Click="OnActualSizeClicked" />
                        <MenuFlyoutItem Text="Fit to Window" Click="OnFitToWindowClicked" />
                        <MenuFlyoutItem Text="Toggle Fullscreen" Click="OnToggleFullscreenClicked" />
                        <MenuFlyoutItem Text="Toggle Theme" Click="OnToggleThemeClicked" />
                    </MenuBarItem>
                    <MenuBarItem Title="Help">
                        <MenuFlyoutItem Text="About spitfire.img" Click="OnAboutClicked" />
                    </MenuBarItem>
                </MenuBar>

                <TextBlock
                    x:Name="ChromeStatusText"
                    Grid.Column="1"
                    MinWidth="{StaticResource ViewerChromeStatusMinWidth}"
                    Padding="{StaticResource ViewerChromeStatusPadding}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource ViewerTextChromeStatusStyle}" />

                <Border
                    x:Name="UnsavedChangesBadge"
                    Grid.Column="2"
                    Padding="{StaticResource ViewerChromeBadgePadding}"
                    Style="{StaticResource ViewerChromeUnsavedBadgeBorderStyle}"
                    Visibility="Collapsed">
                    <TextBlock
                        Style="{StaticResource ViewerTextBadgeStyle}"
                        Text="Unsaved changes" />
                </Border>
            </Grid>
        </Border>

        <views:FrameControl
            x:Name="FrameControl"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="{StaticResource ViewerChromeFrameControlMargin}" />
        <views:BottomInfoBar x:Name="InfoBar" VerticalAlignment="Bottom" Margin="{StaticResource ViewerChromeOuterMargin}" />
    </Grid>
</UserControl>
