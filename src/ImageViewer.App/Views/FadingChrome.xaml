<UserControl
    x:Class="ImageViewer.App.Views.FadingChrome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ImageViewer.App.Views">
    <Grid x:Name="ChromeRoot" IsHitTestVisible="True">
        <Border
            VerticalAlignment="Top"
            Margin="12"
            Padding="8,4"
            Style="{StaticResource ChromePanelBorderStyle}">
            <MenuBar>
                <MenuBarItem x:Name="FileMenu" Title="File">
                    <MenuFlyoutItem Text="Open File" Click="OnOpenFileClicked" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Click="OnExitClicked" />
                </MenuBarItem>
                <MenuBarItem Title="View">
                    <MenuFlyoutItem Text="Zoom In" Click="OnZoomInClicked" />
                    <MenuFlyoutItem Text="Zoom Out" Click="OnZoomOutClicked" />
                    <MenuFlyoutItem Text="Actual Size" Click="OnActualSizeClicked" />
                    <MenuFlyoutItem Text="Fit to Window" Click="OnFitToWindowClicked" />
                    <MenuFlyoutItem Text="Toggle Fullscreen" Click="OnToggleFullscreenClicked" />
                    <MenuFlyoutItem Text="Toggle Theme" Click="OnToggleThemeClicked" />
                </MenuBarItem>
                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Text="About spitfire.img" Click="OnAboutClicked" />
                </MenuBarItem>
            </MenuBar>
        </Border>

        <Border
            x:Name="UnsavedChangesBadge"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="12"
            Padding="10,6"
            CornerRadius="12"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            Visibility="Collapsed">
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Text="Unsaved changes" />
        </Border>

        <views:BottomInfoBar x:Name="InfoBar" VerticalAlignment="Bottom" Margin="12" />
    </Grid>
</UserControl>
