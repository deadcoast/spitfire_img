<UserControl
    x:Class="ImageViewer.App.Views.FadingChrome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ImageViewer.App.Views">
    <Grid x:Name="ChromeRoot" AutomationProperties.Name="Viewer controls">
        <Border x:Name="TopChromeSurface" VerticalAlignment="Top"
                Padding="{StaticResource ViewerMenuBarPadding}" Style="{StaticResource ViewerChromeShellBorderStyle}">
            <Grid x:Name="TopChromeContent" ColumnSpacing="{StaticResource ViewerSpace8}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource ViewerSpace2}">
                    <DropDownButton x:Name="FileMenuButton" Content="File" />
                    <DropDownButton x:Name="ViewMenuButton" Content="View" />
                    <DropDownButton x:Name="BrowseMenuButton" Content="Browse" />
                    <DropDownButton x:Name="ImageMenuButton" Content="Image" />
                    <DropDownButton x:Name="PlayMenuButton" Content="Play" />
                </StackPanel>
                <TextBlock x:Name="ChromeStatusText" Grid.Column="1" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Style="{StaticResource ViewerTextChromeStatusStyle}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource ViewerSpace2}">
                    <Button x:Name="PreviousButton" Tag="navigation.previous" Click="OnCommandClicked"
                            Style="{StaticResource ViewerToolbarButtonStyle}"
                            AutomationProperties.Name="Previous image" ToolTipService.ToolTip="Previous image (Left)">
                        <SymbolIcon Symbol="Back" />
                    </Button>
                    <Button x:Name="NextButton" Tag="navigation.next" Click="OnCommandClicked"
                            Style="{StaticResource ViewerToolbarButtonStyle}"
                            AutomationProperties.Name="Next image" ToolTipService.ToolTip="Next image (Right)">
                        <SymbolIcon Symbol="Forward" />
                    </Button>
                    <Button x:Name="FitButton" Tag="view.fit" Click="OnCommandClicked" Content="Fit"
                            ToolTipService.ToolTip="Fit to window (Ctrl+0)" />
                    <Button x:Name="ActualSizeButton" Tag="view.actual-size" Click="OnCommandClicked" Content="1:1"
                            ToolTipService.ToolTip="Actual pixels (Ctrl+Shift+1)" AutomationProperties.Name="Actual size" />
                    <Button x:Name="SearchButton" Tag="navigation.search" Click="OnCommandClicked"
                            Style="{StaticResource ViewerToolbarButtonStyle}"
                            AutomationProperties.Name="Search folder" ToolTipService.ToolTip="Search folder (Ctrl+F)">
                        <SymbolIcon Symbol="Find" />
                    </Button>
                    <Button Tag="view.command-palette" Click="OnCommandClicked"
                            Style="{StaticResource ViewerToolbarButtonStyle}"
                            AutomationProperties.Name="All commands" ToolTipService.ToolTip="All commands (Ctrl+Shift+P)">
                        <SymbolIcon Symbol="More" />
                    </Button>
                    <Button Tag="view.fullscreen" Click="OnCommandClicked"
                            Style="{StaticResource ViewerToolbarButtonStyle}"
                            AutomationProperties.Name="Toggle fullscreen" ToolTipService.ToolTip="Fullscreen (F11)">
                        <SymbolIcon Symbol="FullScreen" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <views:FrameControl x:Name="FrameControl" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="{StaticResource ViewerChromeFrameControlMargin}" />
        <views:BottomInfoBar x:Name="InfoBar" VerticalAlignment="Bottom" />
    </Grid>
</UserControl>
