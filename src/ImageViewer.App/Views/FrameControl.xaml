<UserControl
    x:Class="ImageViewer.App.Views.FrameControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="ControlRoot"
        MinWidth="360"
        Padding="12,8"
        Style="{StaticResource ChromePanelBorderStyle}"
        Visibility="Collapsed">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="PreviousButton"
                Width="36"
                Height="32"
                Padding="0"
                Click="OnPreviousClicked"
                ToolTipService.ToolTip="Previous frame">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE100;" FontSize="13" />
            </Button>

            <Button
                x:Name="PlayPauseButton"
                Grid.Column="1"
                Width="36"
                Height="32"
                Padding="0"
                Click="OnPlayPauseClicked"
                ToolTipService.ToolTip="Play or pause animation">
                <FontIcon x:Name="PlayPauseIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE769;" FontSize="13" />
            </Button>

            <Button
                x:Name="NextButton"
                Grid.Column="2"
                Width="36"
                Height="32"
                Padding="0"
                Click="OnNextClicked"
                ToolTipService.ToolTip="Next frame">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE101;" FontSize="13" />
            </Button>

            <TextBlock
                x:Name="FrameText"
                Grid.Column="3"
                MinWidth="82"
                VerticalAlignment="Center"
                Foreground="{ThemeResource SecondaryTextBrush}"
                TextAlignment="Center" />

            <Slider
                x:Name="FrameSlider"
                Grid.Column="4"
                VerticalAlignment="Center"
                IsThumbToolTipEnabled="False"
                Maximum="0"
                Minimum="0"
                StepFrequency="1"
                TickFrequency="1"
                ValueChanged="OnSliderValueChanged" />
        </Grid>
    </Border>
</UserControl>
