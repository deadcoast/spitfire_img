<UserControl
    x:Class="ImageViewer.App.Views.ImageCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="CanvasRoot" Background="{ThemeResource CanvasBackgroundBrush}">
        <TextBlock
            x:Name="EmptyStateText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource MutedTextBrush}"
            FontSize="18"
            Text="Open an image to begin" />

        <Grid
            x:Name="ImageTransitionHost"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5"
            ManipulationMode="TranslateX,TranslateY">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="TransitionTransform" />
            </Grid.RenderTransform>
            <Image
                x:Name="DisplayedImage"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                Stretch="Uniform">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="ImageTransform" />
                </Image.RenderTransform>
            </Image>
        </Grid>

        <Grid
            x:Name="PreviousImageTransitionHost"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            RenderTransformOrigin="0.5,0.5"
            Visibility="Collapsed">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="PreviousTransitionTransform" />
            </Grid.RenderTransform>
            <Image
                x:Name="PreviousImage"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                Stretch="Uniform">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="PreviousImageTransform" />
                </Image.RenderTransform>
            </Image>
        </Grid>
    </Grid>
</UserControl>
