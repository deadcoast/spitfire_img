<UserControl
    x:Class="ImageViewer.App.Views.ImageCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="CanvasRoot" Background="{ThemeResource ViewerCanvasBackgroundBrush}">
        <Canvas x:Name="OutgoingHost" IsHitTestVisible="False" Opacity="{StaticResource ViewerHiddenOpacity}" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <CompositeTransform x:Name="OutgoingTransitionTransform" />
            </Canvas.RenderTransform>
            <Image x:Name="OutgoingImage" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="OutgoingImageTransform" />
                </Image.RenderTransform>
            </Image>
        </Canvas>
        <Canvas x:Name="ImageHost" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <CompositeTransform x:Name="IncomingTransitionTransform" />
            </Canvas.RenderTransform>
            <Image
                x:Name="DisplayedImage"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="{StaticResource ViewerHiddenOpacity}"
                RenderTransformOrigin="0.5,0.5"
                Stretch="Fill">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="ImageTransform" />
                </Image.RenderTransform>
            </Image>
        </Canvas>

        <Border
            x:Name="EmptyStateSurface"
            MaxWidth="{StaticResource ViewerEmptyStateMaxWidth}"
            Padding="{StaticResource ViewerEmptyStatePanelPadding}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="Empty image viewer state"
            Background="{ThemeResource ViewerTransparentBrush}">
            <StackPanel Spacing="{StaticResource ViewerEmptyStateContentSpacing}">
                <TextBlock
                    x:Name="EmptyStateKicker"
                    Style="{StaticResource ViewerTextEmptyStateKickerStyle}"
                    Text="spitfire.img" />
                <TextBlock
                    x:Name="EmptyStateTitle"
                    Style="{StaticResource ViewerTextEmptyStateTitleStyle}"
                    Text="Open an image" />
                <TextBlock
                    x:Name="EmptyStateBody"
                    Style="{StaticResource ViewerTextEmptyStateBodyStyle}"
                    Text="Drop a file here. Browse every image in its folder with the arrow keys." />
                <Button x:Name="OpenImageButton" Content="Open image…" Click="OnOpenImageClicked"
                        HorizontalAlignment="Left" Margin="{StaticResource ViewerEmptyActionMargin}"
                        ToolTipService.ToolTip="Open image (Ctrl+O)" />
                <TextBlock
                    x:Name="EmptyStateFormatHint"
                    Style="{StaticResource ViewerTextStatusBodyStyle}"
                    Text="PNG · JPEG · WEBP · BMP · GIF · TIFF&#x0a;HEIC and AVIF with installed Windows codecs" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
