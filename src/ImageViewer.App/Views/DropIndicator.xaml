<UserControl
    x:Class="ImageViewer.App.Views.DropIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Opacity="{StaticResource ViewerHiddenOpacity}"
    Visibility="Collapsed">
    <Grid Background="{ThemeResource ViewerScrimBrush}">
        <Border
            x:Name="DropPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="{StaticResource ViewerOverlayPanelPadding}"
            Style="{StaticResource ViewerOverlayPanelBorderStyle}">
            <TextBlock
                x:Name="MessageText"
                Style="{StaticResource ViewerTextEmptyStateTitleStyle}"
                Text="Drop image to open" />
        </Border>
    </Grid>
</UserControl>
