<UserControl
    x:Class="ImageViewer.App.Views.FilmstripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">
    <Grid
        x:Name="LayoutRoot"
        Background="{ThemeResource CanvasBackgroundBrush}"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Margin="16,16,16,0"
            Background="{ThemeResource CanvasBackgroundBrush}">
            <Image
                x:Name="FocusImage"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                Stretch="Uniform">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="FocusImageTransform" />
                </Image.RenderTransform>
            </Image>
        </Grid>

        <Border
            Grid.Row="1"
            Margin="16,0,16,16"
            Padding="8"
            Style="{StaticResource ChromePanelBorderStyle}">
            <ListView
                x:Name="ThumbnailItems"
                HorizontalAlignment="Center"
                IsItemClickEnabled="True"
                ItemClick="OnThumbnailClicked"
                SelectionMode="None"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Width="116"
                            Margin="0,0,8,0"
                            Padding="5"
                            CornerRadius="8"
                            BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            BorderThickness="{Binding BorderThickness}">
                            <Grid
                                Width="104"
                                Height="104"
                                Background="{ThemeResource SubtlePanelBackgroundBrush}">
                                <Image
                                    Source="{Binding ImageSource}"
                                    Stretch="Uniform" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource MutedTextBrush}"
                                    Text="{Binding PlaceholderText}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
