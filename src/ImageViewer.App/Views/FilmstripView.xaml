<UserControl
    x:Class="ImageViewer.App.Views.FilmstripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ImageViewer.App.Views"
    AutomationProperties.Name="Filmstrip layout surface"
    HorizontalAlignment="Stretch"
    IsTabStop="True"
    VerticalAlignment="Stretch"
    Visibility="Collapsed">
    <Grid
        x:Name="LayoutRoot"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{ThemeResource ViewerCanvasBackgroundBrush}"
        Opacity="{StaticResource ViewerHiddenOpacity}"
        RowSpacing="{StaticResource ViewerFilmstripRowSpacing}">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="FilmstripLayoutTransform" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Margin="{StaticResource ViewerFilmstripTopMargin}"
            Background="{ThemeResource ViewerCanvasBackgroundBrush}">
            <Border
                x:Name="FilmstripFocusSurface"
                Style="{StaticResource ViewerFilmstripFocusBorderStyle}">
                <views:ImageCanvas x:Name="FocusCanvas" />
            </Border>
            <Border
                x:Name="FilmstripModeHud"
                Margin="{StaticResource ViewerGridHudMargin}"
                Padding="{StaticResource ViewerStatusHudPadding}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Style="{StaticResource ViewerStatusHudBorderStyle}">
                <StackPanel Spacing="{StaticResource ViewerCommandRowContentSpacing}">
                    <TextBlock
                        Text="Filmstrip"
                        Style="{StaticResource ViewerTextCommandHeaderStyle}" />
                    <TextBlock
                        x:Name="FilmstripFocusText"
                        Style="{StaticResource ViewerTextStatusStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border
            x:Name="FilmstripThumbnailsSurface"
            Grid.Row="1"
            Margin="{StaticResource ViewerFilmstripBottomMargin}"
            Padding="{StaticResource ViewerCompactPanelPadding}"
            VerticalAlignment="Top"
            Style="{StaticResource ViewerChromePanelBorderStyle}">
            <ListView
                x:Name="FilmstripThumbnailList"
                HorizontalAlignment="Center"
                IsItemClickEnabled="True"
                ItemClick="OnThumbnailClicked"
                ItemContainerStyle="{StaticResource ViewerMediaThumbnailListViewItemStyle}"
                SelectionMode="None"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            x:Name="FilmstripThumbnailCard"
                            Width="{StaticResource ViewerFilmstripThumbnailWidth}"
                            Margin="{StaticResource ViewerTrailingItemMargin}"
                            Padding="{StaticResource ViewerFilmstripThumbnailPadding}"
                            BorderThickness="{Binding BorderThickness}"
                            Style="{StaticResource ViewerMediaThumbnailCardBorderStyle}">
                            <StackPanel Spacing="{StaticResource ViewerThumbnailContentSpacing}">
                                <Border
                                    Width="{StaticResource ViewerFilmstripPreviewSize}"
                                    Height="{StaticResource ViewerFilmstripPreviewSize}"
                                    Style="{StaticResource ViewerMediaThumbnailPreviewBorderStyle}">
                                    <Grid>
                                        <Image
                                            Source="{Binding ImageSource}"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource ViewerTextCaptionStyle}"
                                            Text="{Binding PlaceholderText}" />
                                    </Grid>
                                </Border>
                                <Grid ColumnSpacing="{StaticResource ViewerThumbnailContentSpacing}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{Binding FileName}"
                                        Style="{StaticResource ViewerTextCaptionStyle}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="FilmstripCurrentBadge"
                                        Grid.Column="1"
                                        Text="{Binding CurrentLabel}"
                                        Style="{StaticResource ViewerTextCaptionStyle}" />
                                </Grid>
                                <TextBlock
                                    x:Name="FilmstripStatusBadge"
                                    Text="{Binding StatusText}"
                                    Style="{StaticResource ViewerTextCaptionStyle}"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
