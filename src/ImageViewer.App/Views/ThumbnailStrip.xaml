<UserControl
    x:Class="ImageViewer.App.Views.ThumbnailStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Thumbnail strip"
    Visibility="Collapsed">
    <Border
        x:Name="StripBorder"
        Margin="{StaticResource ViewerChromeOuterMargin}"
        Padding="{StaticResource ViewerCompactPanelPadding}"
        VerticalAlignment="Bottom"
        Style="{StaticResource ViewerChromePanelBorderStyle}">
        <Border.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Border.Transitions>
        <ListView
            x:Name="ThumbnailStripList"
            IsItemClickEnabled="True"
            ItemClick="OnThumbnailClicked"
            ItemContainerStyle="{StaticResource ViewerMediaThumbnailListViewItemStyle}"
            SelectionMode="None"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollMode="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border
                        x:Name="ThumbnailStripItemCard"
                        Width="{StaticResource ViewerThumbnailItemWidth}"
                        Margin="{StaticResource ViewerTrailingItemMargin}"
                        Padding="{StaticResource ViewerThumbnailItemPadding}"
                        BorderThickness="{Binding BorderThickness}"
                        Style="{StaticResource ViewerMediaThumbnailCardBorderStyle}">
                        <StackPanel Spacing="{StaticResource ViewerThumbnailContentSpacing}">
                            <Border
                                Width="{StaticResource ViewerThumbnailPreviewSize}"
                                Height="{StaticResource ViewerThumbnailPreviewSize}"
                                Style="{StaticResource ViewerMediaThumbnailPreviewBorderStyle}">
                                <Grid>
                                    <Image
                                        Source="{Binding ImageSource}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding PlaceholderText}"
                                        Style="{StaticResource ViewerTextCaptionStyle}" />
                                </Grid>
                            </Border>
                            <Grid ColumnSpacing="{StaticResource ViewerThumbnailContentSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{Binding FileName}"
                                    Style="{StaticResource ViewerTextCaptionStyle}"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="ThumbnailCurrentBadge"
                                    Grid.Column="1"
                                    Text="{Binding CurrentLabel}"
                                    Style="{StaticResource ViewerTextCaptionStyle}" />
                            </Grid>
                            <TextBlock
                                x:Name="ThumbnailStatusBadge"
                                Text="{Binding StatusText}"
                                Style="{StaticResource ViewerTextCaptionStyle}"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Border>
</UserControl>
