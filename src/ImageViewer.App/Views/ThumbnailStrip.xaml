<UserControl
    x:Class="ImageViewer.App.Views.ThumbnailStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">
    <Border
        x:Name="StripBorder"
        Margin="12"
        Padding="8"
        VerticalAlignment="Bottom"
        Style="{StaticResource ChromePanelBorderStyle}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Items">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Width="132"
                            Padding="6"
                            CornerRadius="8"
                            BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            BorderThickness="{Binding BorderThickness}">
                            <StackPanel Spacing="4">
                                <Grid Width="120" Height="120" Background="{ThemeResource SubtlePanelBackgroundBrush}">
                                    <Image
                                        Source="{Binding ImageSource}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding PlaceholderText}"
                                        Foreground="{ThemeResource MutedTextBrush}" />
                                </Grid>
                                <TextBlock
                                    Text="{Binding FileName}"
                                    FontSize="11"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
