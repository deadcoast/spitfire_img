<UserControl
    x:Class="ImageViewer.App.Views.ComparisonView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Comparison image review surface">
    <Grid
        x:Name="ComparisonRoot"
        Background="{ThemeResource ViewerCanvasBackgroundBrush}"
        Visibility="Collapsed">
        <Grid x:Name="ImageHost" />
        <Border
            x:Name="ComparisonModeHud"
            Width="{StaticResource ViewerComparisonHudWidth}"
            Margin="{StaticResource ViewerComparisonModeHudMargin}"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource ViewerComparisonHudBorderStyle}">
            <Grid RowSpacing="{StaticResource ViewerGridHudSpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="Comparison"
                    Style="{StaticResource ViewerTextChromeLabelStyle}" />
                <TextBlock
                    x:Name="ComparisonModeText"
                    Grid.Row="1"
                    Style="{StaticResource ViewerTextChromeValueStyle}" />
                <TextBlock
                    x:Name="ComparisonCountText"
                    Grid.Row="2"
                    Style="{StaticResource ViewerTextStatusStyle}" />
                <Grid
                    Grid.Row="3"
                    ColumnSpacing="{StaticResource ViewerGridHudSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ComparisonActiveText"
                        Style="{StaticResource ViewerTextStatusStyle}" />
                    <Border
                        Grid.Column="1"
                        Style="{StaticResource ViewerStatusChipBorderStyle}">
                        <TextBlock
                            x:Name="ComparisonSyncText"
                            Style="{StaticResource ViewerTextCaptionStyle}" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <Border
            x:Name="OverlayControls"
            Width="{StaticResource ViewerComparisonHudWidth}"
            Margin="{StaticResource ViewerComparisonHudMargin}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Style="{StaticResource ViewerComparisonHudBorderStyle}"
            Visibility="Collapsed">
            <Grid RowSpacing="{StaticResource ViewerGridHudSpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="{StaticResource ViewerGridHudSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="Overlay opacity"
                        Style="{StaticResource ViewerTextChromeLabelStyle}" />
                    <TextBlock
                        x:Name="OverlayOpacityText"
                        Grid.Column="1"
                        Style="{StaticResource ViewerTextNumericStyle}" />
                </Grid>
                <Slider
                    x:Name="OverlayOpacitySlider"
                    Grid.Row="1"
                    AutomationProperties.Name="Overlay opacity"
                    Minimum="0"
                    Maximum="100"
                    SmallChange="10"
                    StepFrequency="10"
                    ValueChanged="OnOverlayOpacitySliderChanged" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
