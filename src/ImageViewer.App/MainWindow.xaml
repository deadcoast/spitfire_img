<Window
    x:Class="ImageViewer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ImageViewer.App"
    xmlns:views="using:ImageViewer.App.Views"
    Title="spitfire.img">
    <Grid
        x:Name="RootGrid"
        IsTabStop="True"
        AllowDrop="True"
        Background="{ThemeResource ViewerCanvasBackgroundBrush}"
        DragLeave="OnRootDragLeave"
        DragOver="OnRootDragOver"
        Drop="OnRootDrop"
        KeyDown="OnRootKeyDown"
        PointerMoved="OnRootPointerMoved">
        <views:ImageCanvas x:Name="ImageCanvas" />
        <views:ComparisonView x:Name="ComparisonView" />
        <views:GridLayout x:Name="GridLayout" />
        <views:FilmstripView x:Name="FilmstripView" />
        <views:ThumbnailStrip x:Name="ThumbnailStrip" />
        <views:FadingChrome x:Name="Chrome" />
        <views:SearchOverlay x:Name="SearchOverlay" />
        <views:MetadataPanel x:Name="MetadataPanel" />
        <views:DropIndicator x:Name="DropIndicator" />
        <views:CommandPalette x:Name="CommandPalette" />

        <InfoBar
            x:Name="ErrorInfoBar"
            Margin="{StaticResource ViewerStatusInfoBarMargin}"
            MaxWidth="{StaticResource ViewerStatusPanelMaxWidth}"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.Name="Image warning or error status"
            IsOpen="False"
            IsClosable="True"
            Severity="Error">
            <InfoBar.ActionButton>
                <Button
                    x:Name="ErrorRecoveryButton"
                    Click="OnErrorRecoveryClicked"
                    Content="Open image"
                    Visibility="Collapsed" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Border
            x:Name="LoadingOverlay"
            MaxWidth="{StaticResource ViewerStatusPanelMaxWidth}"
            Padding="{StaticResource ViewerStatusSurfacePadding}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="Image loading status"
            Style="{StaticResource ViewerLoadingStatusBorderStyle}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="{StaticResource ViewerStatusSurfaceSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ProgressRing
                    x:Name="LoadingRing"
                    Width="{StaticResource ViewerLoadingRingSize}"
                    Height="{StaticResource ViewerLoadingRingSize}"
                    VerticalAlignment="Top"
                    IsActive="False" />

                <StackPanel
                    Grid.Column="1"
                    Spacing="{StaticResource ViewerEmptyStateContentSpacing}">
                    <TextBlock
                        x:Name="LoadingStatusTitle"
                        Style="{StaticResource ViewerTextStatusTitleStyle}"
                        Text="Preparing image" />
                    <TextBlock
                        x:Name="LoadingStatusBody"
                        Style="{StaticResource ViewerTextStatusBodyStyle}"
                        Text="Decoding the file while the viewer remains available." />
                    <Button
                        x:Name="CancelLoadingButton"
                        Click="OnCancelLoadingClicked"
                        Content="Cancel loading"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
